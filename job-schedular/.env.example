# Database (same PostgreSQL database as Next.js/Prisma)
# Note: SQLAlchemy with psycopg3 uses 'postgresql+psycopg://...'
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/ecommerce_db

# Redis Broker (DB 0) & Result Backend (DB 1)
REDIS_URL_BROKER=redis://localhost:6379/0
REDIS_URL_BACKEND=redis://localhost:6379/1

# Internal Security Token (required for Bearer auth on all /jobs/* endpoints)
INTERNAL_SERVICE_TOKEN=your_secure_internal_service_token_here

# Frontend Application Origin (used to generate password reset links, order URLs)
APP_FRONTEND_URL=http://localhost:3000

# SMTP Configuration for Transactional Emails
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_USE_TLS=true
EMAIL_FROM=Ecommerce Store <noreply@ecommerceapp.com>

# Celery Configuration
CELERY_TIMEZONE=Asia/Karachi
LOG_LEVEL=INFO

# Automation & Lifecycle Timing Configuration (Hours / Minutes)
UNPAID_ORDER_REJECTION_HOURS=120
CANCELLATION_WARNING_HOURS_BEFORE=24
BEAT_UNPAID_ORDER_CHECK_INTERVAL_MINUTES=60

# Cloudinary Image Upload Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

